module

public import Cage87.Check
public import Cage87.Data

@[expose] public section

/-!
# The kernel checks

The branch check of every vertex, in 8 chunks of 96 vertices (generated by
`scripts/make_data.py`); each chunk is a separate kernel computation (`decide +kernel`).
`wf_ok` checks the adjacency lists.
-/

namespace Cage87

theorem wf_ok : wfOk adj 768 8 = true := by decide +kernel

theorem chunk_0 : verticesOk adj 0 96 = true := by decide +kernel

theorem chunk_1 : verticesOk adj 96 96 = true := by decide +kernel

theorem chunk_2 : verticesOk adj 192 96 = true := by decide +kernel

theorem chunk_3 : verticesOk adj 288 96 = true := by decide +kernel

theorem chunk_4 : verticesOk adj 384 96 = true := by decide +kernel

theorem chunk_5 : verticesOk adj 480 96 = true := by decide +kernel

theorem chunk_6 : verticesOk adj 576 96 = true := by decide +kernel

theorem chunk_7 : verticesOk adj 672 96 = true := by decide +kernel

/-- Every vertex passes the branch check. -/
theorem vertices_ok (v : Nat) (hv : v < 768) : vertexOk adj v = true := by
  have : (0 ≤ v ∧ v < 96) ∨ (96 ≤ v ∧ v < 192) ∨ (192 ≤ v ∧ v < 288) ∨ (288 ≤ v ∧ v < 384) ∨ (384 ≤ v ∧ v < 480) ∨ (480 ≤ v ∧ v < 576) ∨ (576 ≤ v ∧ v < 672) ∨ (672 ≤ v ∧ v < 768) := by omega
  rcases this with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
  · exact verticesOk_mem adj 0 96 chunk_0 v h0.1 (by omega)
  · exact verticesOk_mem adj 96 96 chunk_1 v h1.1 (by omega)
  · exact verticesOk_mem adj 192 96 chunk_2 v h2.1 (by omega)
  · exact verticesOk_mem adj 288 96 chunk_3 v h3.1 (by omega)
  · exact verticesOk_mem adj 384 96 chunk_4 v h4.1 (by omega)
  · exact verticesOk_mem adj 480 96 chunk_5 v h5.1 (by omega)
  · exact verticesOk_mem adj 576 96 chunk_6 v h6.1 (by omega)
  · exact verticesOk_mem adj 672 96 chunk_7 v h7.1 (by omega)

end Cage87
